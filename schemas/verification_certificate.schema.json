{
  "$defs": {
    "CertificateCheck": {
      "properties": {
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked": {
          "default": 0,
          "title": "Checked",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/CertificateIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "status"
      ],
      "title": "CertificateCheck",
      "type": "object"
    },
    "CertificateClaim": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "numeric",
            "causal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        },
        "status": {
          "enum": [
            "grounded",
            "ungrounded",
            "ignored",
            "flagged",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "severity": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "normalized": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "span",
        "status"
      ],
      "title": "CertificateClaim",
      "type": "object"
    },
    "CertificateEvidence": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "calculation",
            "table_cell",
            "table_column",
            "note",
            "warning"
