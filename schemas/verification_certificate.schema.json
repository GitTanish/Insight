          "title": "Detail"
        },
        "recomputation": {
          "enum": [
            "verified",
            "mismatch",
            "not_covered",
            "not_checked"
          ],
          "title": "Recomputation",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "operation",
        "label",
        "recomputation"
      ],
      "title": "ReportedAggregate",
      "type": "object"
    }
