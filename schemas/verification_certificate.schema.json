        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "numbers": {
          "items": {
            "type": "number"
          },
          "title": "Numbers",
          "type": "array"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "CertificateEvidence",
      "type": "object"
    },
    "CertificateIssue": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CertificateIssue",
      "type": "object"
    },
    "CertificateTable": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "columns",
        "rows",
        "digest"
      ],
      "title": "CertificateTable",
      "type": "object"
    },
    "CertificateVerdict": {
      "properties": {
        "overall": {
          "enum": [
            "pass",
            "pass_with_warnings",
            "fail"
          ],
          "title": "Overall",
          "type": "string"
        },
        "grounded": {
          "title": "Grounded",
          "type": "boolean"
        },
        "recomputed": {
          "enum": [
            "pass",
            "fail",
            "not_checked"
          ],
          "title": "Recomputed",
          "type": "string"
        },
        "statistical_validity": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_checked"
          ],
          "title": "Statistical Validity",
          "type": "string"
        },
        "causal_overreach": {
          "enum": [
            "pass",
            "warn",
            "not_checked"
          ],
          "title": "Causal Overreach",
          "type": "string"
        },
        "structural": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_checked"
          ],
          "title": "Structural",
          "type": "string"
        }
      },
      "required": [
        "overall",
        "grounded",
        "recomputed",
        "statistical_validity",
        "causal_overreach",
        "structural"
      ],
      "title": "CertificateVerdict",
      "type": "object"
    },
    "ReportedAggregate": {
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "integer"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
