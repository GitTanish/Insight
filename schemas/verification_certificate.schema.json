  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "certificate_id": {
      "title": "Certificate Id",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "verifier": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Verifier",
      "type": "object"
    },
    "attestation_level": {
      "enum": [
        "grounding",
        "recomputed"
      ],
      "title": "Attestation Level",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "title": "Subject",
      "type": "object"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/CertificateTable"
      },
      "title": "Tables",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/CertificateEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "aggregates": {
      "items": {
        "$ref": "#/$defs/ReportedAggregate"
      },
      "title": "Aggregates",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/CertificateClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "checks": {
      "additionalProperties": {
        "$ref": "#/$defs/CertificateCheck"
      },
      "title": "Checks",
      "type": "object"
    },
    "verdict": {
      "$ref": "#/$defs/CertificateVerdict"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "signature": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    }
  },
  "required": [
    "certificate_id",
    "issued_at",
    "verifier",
    "attestation_level",
    "subject",
    "verdict"
  ],
  "title": "VerificationCertificate",
  "type": "object"
}
