# ---- Insight LLM providers ----
# Enable any / all / none of these. Each key unlocks its provider's models
# automatically; missing keys simply hide that provider from the dropdown.

# Groq (default provider; gpt-oss-120b/20b, qwen3.8-27b)
GROQ_API_KEY=

# Second Groq account (optional) — same models via a separate quota pool,
# shown as groq2/... model ids. Doubles fallback depth + rate-limit headroom:
GROQ_API_KEY2=

# Mistral
MISTRAL_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter aggregator (400+ models via live discovery)
OPENROUTER_API_KEY=

# NVIDIA NIM (40 req/min; gpt-oss-20b curated + live model discovery)
NVIDIA_API_KEY=

# Ollama (local). Set a base URL or flip the enable flag:
# OLLAMA_BASE_URL=http://localhost:11434/v1
INSIGHT_ENABLE_OLLAMA=0

# ---- Any other OpenAI-compatible service (DeepSeek, Together, Fireworks...) ----
INSIGHT_CUSTOM_BASE_URL=
INSIGHT_CUSTOM_API_KEY=
# Comma-separated model ids; leave empty to auto-discover via GET {base_url}/models
INSIGHT_CUSTOM_MODELS=
# Off = show ONLY the curated INSIGHT_CUSTOM_MODELS list (skip /models discovery)
INSIGHT_CUSTOM_DISCOVERY=on
# Display name in the UI (optional)
INSIGHT_CUSTOM_NAME=custom

# ---- Optional tuning ----
# INSIGHT defaults live in insight/settings.py
# Cache identical (dataset, question, model, temperature) results under .artifacts/cache:
# INSIGHT_QUERY_CACHE=on
# INSIGHT_QUERY_CACHE_TTL_DAYS=14
# INSIGHT_QUERY_CACHE_MAX_MB=512
# Polish briefing headlines with one extra fast LLM call (default off).
# When on, this runs in the background and never blocks the upload response:
# INSIGHT_BRIEFING_LLM_POLISH=off
# Human-in-the-loop: stop at a reviewable plan before executing any data.
# The user can edit the plan JSON, then Approve & run.
# INSIGHT_PLAN_APPROVAL=off
# Agentic tool-use mode: the model calls ops as tools one at a time, observes
# each computed result, and iterates (bounded, same verification as a plan).
# Both UIs also expose a per-question Agent mode toggle.
# INSIGHT_AGENTIC=off
# INSIGHT_AGENTIC_MAX_ITERATIONS=5
# INSIGHT_AGENTIC_MAX_LLM_CALLS=9
# Seconds between agentic provider calls (headroom on rate-limited tiers):
# INSIGHT_AGENTIC_DELAY_S=0

# ---- Observability (optional) ----
# Set a LangSmith key to enable full pipeline tracing (plan, steps, LLM calls).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insight

# ---- Deployment security (see PRODUCTION_READINESS.md) ----
# Require auth on every route except /healthz, /health, /readyz and /auth.
# API clients send "Authorization: Bearer <token>"; browsers open
# /auth?token=<token> once to receive the HttpOnly cookie.
# INSIGHT_AUTH_TOKEN=
# Or trust an authenticating reverse proxy that sends X-Forwarded-User:
# INSIGHT_TRUST_PROXY_AUTH=off
# Mark cookies Secure when served over TLS:
# INSIGHT_COOKIE_SECURE=off
# Per-identity sliding-window limits (requests/minute):
# INSIGHT_RATE_LIMIT=on
# INSIGHT_RATE_LIMIT_PER_MINUTE=60
# INSIGHT_UPLOAD_RATE_LIMIT_PER_MINUTE=10
# In-memory session caps (the app is single-worker by design):
# INSIGHT_SESSION_MAX=64
# INSIGHT_SESSION_TTL_MINUTES=240
# INSIGHT_SESSION_MAX_TURNS=25
# Rows accepted per uploaded table (checked before a full parse):
# INSIGHT_MAX_UPLOAD_ROWS=1000000
# Startup retention sweep for .artifacts/web/* (tools/retention.py for cron):
# INSIGHT_ARTIFACT_RETENTION_DAYS=14

# ---- MCP server hardening ----
# Transport: stdio (default) | sse | streamable-http
# INSIGHT_MCP_TRANSPORT=stdio
# INSIGHT_MCP_HOST=127.0.0.1
# INSIGHT_MCP_PORT=8765
# stdio needs no auth. sse/streamable-http refuse to start without a token.
# INSIGHT_MCP_AUTH_TOKEN=
# INSIGHT_MCP_ALLOW_UNAUTHENTICATED=0
# Path loads are restricted to these roots (os.pathsep-separated).
# Unset = current working directory; "all" = unrestricted; "none" = disable.
# INSIGHT_MCP_FILE_ROOTS=
# INSIGHT_MCP_MAX_FILE_MB=80
# Retained run snapshots and registered table names:
# INSIGHT_MCP_MAX_RUNS=100
# INSIGHT_MCP_MAX_TABLES=64
# Extra Host-header allowlist for DNS-rebinding protection (comma-separated):
# INSIGHT_MCP_ALLOWED_HOSTS=