# ---- Insight LLM providers ----
# Enable any / all / none of these. Each key unlocks its provider's models
# automatically; missing keys simply hide that provider from the dropdown.

# Groq (default provider; gpt-oss-120b/20b, qwen3.8-27b)
GROQ_API_KEY=

# Mistral
MISTRAL_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter aggregator (400+ models via live discovery)
OPENROUTER_API_KEY=

# Ollama (local). Set a base URL or flip the enable flag:
# OLLAMA_BASE_URL=http://localhost:11434/v1
INSIGHT_ENABLE_OLLAMA=0

# ---- Any other OpenAI-compatible service (NVIDIA NIM, DeepSeek, Together...) ----
# Example, NVIDIA NIM (40 req/min, tool-calling models):
#   INSIGHT_CUSTOM_NAME=nvidia
#   INSIGHT_CUSTOM_BASE_URL=https://integrate.api.nvidia.com/v1
#   INSIGHT_CUSTOM_API_KEY=nvapi-...
#   INSIGHT_CUSTOM_MODELS=openai/gpt-oss-20b
INSIGHT_CUSTOM_BASE_URL=
INSIGHT_CUSTOM_API_KEY=
# Comma-separated model ids; leave empty to auto-discover via GET {base_url}/models
INSIGHT_CUSTOM_MODELS=
# Off = show ONLY the curated INSIGHT_CUSTOM_MODELS list (skip /models discovery)
INSIGHT_CUSTOM_DISCOVERY=on
# Display name in the UI (optional)
INSIGHT_CUSTOM_NAME=custom

# ---- Optional tuning ----
# INSIGHT defaults live in insight/settings.py
# Cache identical (dataset, question, model, temperature) results under .artifacts/cache:
# INSIGHT_QUERY_CACHE=on
# INSIGHT_QUERY_CACHE_TTL_DAYS=14
# INSIGHT_QUERY_CACHE_MAX_MB=512
# Polish briefing headlines with one extra fast LLM call (default off).
# When on, this runs in the background and never blocks the upload response:
# INSIGHT_BRIEFING_LLM_POLISH=off
# Human-in-the-loop: stop at a reviewable plan before executing any data.
# The user can edit the plan JSON, then Approve & run.
# INSIGHT_PLAN_APPROVAL=off
# Agentic tool-use mode: the model calls ops as tools one at a time, observes
# each computed result, and iterates (bounded, same verification as a plan).
# Both UIs also expose a per-question Agent mode toggle.
# INSIGHT_AGENTIC=off
# INSIGHT_AGENTIC_MAX_ITERATIONS=5
# INSIGHT_AGENTIC_MAX_LLM_CALLS=9
# Seconds between agentic provider calls (headroom on rate-limited tiers):
# INSIGHT_AGENTIC_DELAY_S=0

# ---- Observability (optional) ----
# Set a LangSmith key to enable full pipeline tracing (plan, steps, LLM calls).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insight

